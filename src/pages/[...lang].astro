---
import { cv, links, certifications, tech, project, atlasStart, tenure, type Lang } from '../cv';

// English lives at /, Spanish at /es.
export function getStaticPaths() {
	return [{ params: { lang: undefined } }, { params: { lang: 'es' } }];
}

const lang: Lang = Astro.params.lang === 'es' ? 'es' : 'en';
const t = cv[lang];
const otherLangHref = t.otherLang.code === 'es' ? '/es' : '/';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{t.pageTitle}</title>
		<meta name="description" content={t.description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	</head>
	<body>
		<div class="sheet">
			<header>
				<h1>{t.name}</h1>
				<div class="what">
					<p>{t.role}</p>
					<p class="quiet">{t.location}</p>
					<ul class="inline" aria-label={t.headings.contact}>
						<li><a href={`mailto:${links.email}`}>{links.email}</a></li>
						<li><a href={links.linkedin}>LinkedIn</a></li>
						<li><a href={links.github}>GitHub</a></li>
					</ul>
				</div>
				<p class="lang quiet">
					<a href={otherLangHref} lang={t.otherLang.code} hreflang={t.otherLang.code}>{t.otherLang.label}</a>
				</p>
			</header>

			<main>
				<section>
					<h2>{t.headings.work}</h2>
					<div class="row">
						<p class="quiet">{t.job.period}<br /><span data-since={atlasStart}>{tenure(atlasStart, lang)}</span></p>
						<div class="what">
							<h3>{t.job.company}</h3>
							<p>{t.job.summary}</p>
						</div>
					</div>
				</section>

				<section>
					<h2>{t.headings.projects}</h2>
					<div class="row">
						<div class="what">
							<h3><a href={project.url}>{project.name}</a></h3>
							<p class="quiet">{t.projectSummary}</p>
							<ul class="inline quiet" aria-label={t.builtWith}>
								{project.stack.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					</div>
				</section>

				<section>
					<h2>{t.headings.certifications}</h2>
					<ul>
						{certifications.map((cert) => (
							<li class="row">
								<p class="quiet">{cert.year}</p>
								<p class="what">
									{cert.url ? <a href={cert.url}>{cert.name}</a> : cert.name}<span class="quiet">, {cert.issuer}{cert.credentialId && `, ID ${cert.credentialId}`}</span>
								</p>
							</li>
						))}
						<li class="row">
							<p class="what"><a href={links.linkedin}>{t.certificationsLink}</a></p>
						</li>
					</ul>
				</section>

				<section>
					<h2>{t.headings.education}</h2>
					<div class="row">
						<p class="quiet">{t.education.period}</p>
						<div class="what">
							<h3>{t.education.school}</h3>
							<p class="quiet">{t.education.title}</p>
						</div>
					</div>
				</section>

				<section>
					<h2>{t.headings.tech}</h2>
					<div class="row">
						<ul class="inline what">
							{tech.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</section>
			</main>
		</div>

		<script>
			import '../tenure';
		</script>
	</body>
</html>

<style is:global>
	/* The register: one size, one leading, two columns, two inks. */
	:root {
		--ink: #000;
		--quiet: #6b6b6b; /* 5.3:1 on white */
		--line: 1.5rem;
		--label: 11rem;
		--gutter: 1rem;
		color-scheme: light;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body {
		margin: 0;
		background: #fff;
		color: var(--ink);
		font: 400 1rem/var(--line) 'Helvetica Neue', Helvetica, Arial, 'Segoe UI', sans-serif;
		font-variant-numeric: tabular-nums;
		font-synthesis: none;
		overflow-wrap: break-word;
	}

	h1,
	h2,
	h3,
	p,
	ul {
		margin: 0;
		padding: 0;
		font: inherit;
	}

	ul {
		list-style: none;
	}

	p,
	li {
		text-wrap: pretty;
	}

	.sheet {
		max-width: 46rem;
		margin-inline: auto;
		padding: calc(var(--line) * 3) 1.5rem;
	}

	/* Every line on the page hangs from this grid. */
	.row,
	header {
		display: grid;
		grid-template-columns: var(--label) minmax(0, 1fr);
		column-gap: var(--gutter);
	}

	.what {
		grid-column: 2;
		min-width: 0;
	}

	.quiet {
		color: var(--quiet);
	}

	header h1 {
		grid-column: 1;
		grid-row: 1;
	}

	header .what {
		grid-row: 1 / span 3;
	}

	header .lang {
		grid-column: 1;
		grid-row: 3;
	}

	.inline li {
		display: inline;
	}

	.inline li:not(:last-child)::after {
		content: ', ';
	}

	/* Rule plus space always adds up to two whole lines, so baselines hold. */
	section {
		margin-top: calc(var(--line) * 1.5 - 1px);
		padding-top: calc(var(--line) * 0.5);
		border-top: 1px solid var(--quiet);
	}

	a {
		color: inherit;
		padding-block: 0.1875rem; /* 24px hit area, no layout shift */
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	a:hover {
		text-decoration-thickness: 2px;
	}

	a:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: no-preference) {
		a {
			transition: text-decoration-thickness 120ms linear;
		}
	}

	/* Narrow sheet: the left column stacks above the right, in the same order. */
	@media screen and (max-width: 40rem) {
		.sheet {
			padding: calc(var(--line) * 2) 1.25rem;
		}

		.row,
		header {
			display: block;
		}

		header .lang {
			margin-top: var(--line);
		}

		.row + .row {
			margin-top: var(--line);
		}

		h2 {
			margin-bottom: var(--line);
		}
	}

	@media print {
		@page {
			size: A4;
			margin: 20mm;
		}

		html {
			font-size: 11pt;
		}

		.sheet {
			max-width: none;
			padding: 0;
		}

		section {
			break-inside: avoid;
		}

		a {
			text-decoration-thickness: 0.5pt;
		}
	}
</style>
